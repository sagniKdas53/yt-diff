# YT-DB options
DB_USERNAME=ytdiff
DB_NAME=vidlist
DB_HOST=yt-db
# Port inside the compose network. The host-published ports are deliberately
# non-default so they cannot collide with another project's postgres/redis;
# override DB_HOST_PORT / REDIS_HOST_PORT to change what the host sees.
DB_PORT=5432
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
# PGADMIN options
# See secrets/pg_admin_email.txt and secrets/pg_admin_password.txt for credentials
# YT-DIFF options
PROTOCOL=https
PORT=8888
BASE_URL=/ytdiff
HIDE_PORTS=true
NATIVE_HTTPS_SUPPORT=false
NO_COLOR=true
# Cookies file for yt-dlp, if you don't need it, leave it blank
# Using a relative path is okay, but an absolute path works best
CONTAINER_COOKIES_FILE=/home/ytdiff/cookies.txt
# Rate limiting.
#
# Two tiers. The admission tier runs before authentication, so it can only key
# on the client address and count requests -- its job is stopping an
# unauthenticated flood. The work tier runs after the body is parsed and the
# user is verified, and charges in units of queued work, so one request that
# queues 200 playlist re-scans is priced as 200 re-scans rather than as one
# request.
#
# Every budget is "units per period". Set any burst to 0 to disable that tier.
# Defaults sit well above realistic interactive use and above what the E2E
# suite generates, so normal sessions and test runs never see a 429.

# Admission: login and registration. Kept tight, this is the brute-force
# surface.
RATE_LIMIT_AUTH_BURST=30
RATE_LIMIT_AUTH_REFILL=30
RATE_LIMIT_AUTH_PERIOD_SEC=3600

# Admission: unauthenticated reads such as /isregallowed, which the login page
# calls on every load.
RATE_LIMIT_PUBLIC_BURST=240
RATE_LIMIT_PUBLIC_REFILL=240
RATE_LIMIT_PUBLIC_PERIOD_SEC=3600

# Admission: /list and /download. Deliberately loose; cost is priced below.
RATE_LIMIT_ACTION_BURST=600
RATE_LIMIT_ACTION_REFILL=600
RATE_LIMIT_ACTION_PERIOD_SEC=3600

# Work: charged per user, in units of queued work.
# 3000/hour absorbs a select-all download of ~3000 videos, or ~300 playlist
# re-scans, before throttling.
RATE_LIMIT_WORK_BURST=3000
RATE_LIMIT_WORK_REFILL=3000
RATE_LIMIT_WORK_PERIOD_SEC=3600

# What each kind of work costs.
# A Full/Refresh listing walks an entire playlist; Start/End only touch its
# head or tail; a download is bounded per video and explicitly requested.
RATE_LIMIT_WEIGHT_BASE=1
RATE_LIMIT_WEIGHT_LIST_FULL=10
RATE_LIMIT_WEIGHT_LIST_INCREMENTAL=2
RATE_LIMIT_WEIGHT_DOWNLOAD=1

# Which hops' X-Forwarded-For may be believed, as a comma-separated list of
# addresses, CIDRs, or the shorthands "loopback", "linklocal" and "private".
#
# The admission tier keys on the client address, but behind a reverse proxy
# every request arrives from the proxy, so without this every user shares one
# bucket and one noisy client can lock out the rest. X-Forwarded-For fixes
# that -- but it is a request header any client can forge, so it is only read
# when the socket peer is listed here.
#
# Empty (the default) means the socket peer is the client, which is right for
# a directly-exposed server. Set it to "private" for the usual compose
# deployment, where the proxy sits on the bridge network; name the proxy's
# address exactly if anything untrusted can also reach the container.
TRUSTED_PROXIES=

CACHE_MAX_ITEMS=500
# The front-end will refresh the file 5 mins before expiry (300000 ms), so don't set it less than that, also this is in seconds not ms
CACHE_MAX_AGE=3600
# Registration
ALLOW_REGISTRATION=true
# Max users allowed to sign up, default is 15
MAX_USERS=1
# How long a login token stays valid. Anything jsonwebtoken accepts as
# expiresIn works ("12h", "7d"). This was 31 days, chosen so the app could skip
# renewal entirely; the client renews against POST /refresh now, so the long
# lifetime buys nothing and a leaked token is valid for a day instead of a
# month. Raising it does not need a client change — the client reads the expiry
# the server sends back.
TOKEN_EXPIRY=24h
# Using a relative path is okay, but a absolute path works best
CONTAINER_SAVE_PATH=/home/ytdiff/Videos/yt-dlp/
# 0 works but don't use it, please
SLEEP=3
# https://github.com/TeamNewPipe/NewPipe/issues/875#issuecomment-347592489
CHUNK_SIZE_DEFAULT=10
# Save English subtitles and convert them to VTT so the browser player can render them directly.
SAVE_SUBTITLES=true
# Not saving these as well as these are not that important to me right now
SAVE_COMMENTS=false
# Saving description
SAVE_DESCRIPTION=true
# These are necessary for proper thumbnail display in the webui
SAVE_THUMBNAIL=true
# Having issues with certain filenames, so restricting them
RESTRICT_FILENAMES=true
# 255 is the max filename length for ext4 filesystems, but leaving some buffer
MAX_FILENAME_LENGTH=240
MAX_DOWNLOADS=1
MAX_LISTINGS=1
CLEANUP_INTERVAL=*/30 * * * *
PROCESS_MAX_AGE=1800000
# CRON expression used here, use https://crontab.guru/ for examples
UPDATE_SCHEDULED=0 4 * * *
PRUNE_INTERVAL=0 2 * * *
TZ_PREFERRED=Asia/Kolkata
# CHAT BOT options
# Master switch. Nothing is constructed when false.
BOT_ENABLED=true
# Comma-separated chat IDs permitted to command the bot. Empty = bot stays off.
# The bot FAILS CLOSED: enabled with an empty allowlist logs an error and starts nothing,
# because an open bot lets anyone who can message it make this server fetch arbitrary URLs.
BOT_ALLOWED_CHAT_IDS=1391594622
# Token via secrets file (preferred) or BOT_TELEGRAM_TOKEN inline.
# The token is wired in docker-compose.yml, not here: uncomment the `bot_token`
# secret, the `- bot_token` service reference, and BOT_TELEGRAM_TOKEN_FILE.
# The file it reads is secrets/bot_token.txt. See docs/BOT.md section 2.
# Optional override for the origin used to build download links. Left empty,
# links use the same origin the server logs at startup (PROTOCOL://HOSTNAME,
# plus :PORT unless HIDE_PORTS=true) — correct whenever HOSTNAME is externally
# reachable, which it is here. Only set this when it is not: a
# container-internal HOSTNAME, or a reverse proxy answering on another name.
# BOT_PUBLIC_BASE_URL=
# ephemeral (file reaped after BOT_RETENTION_HOURS) | persistent
BOT_RETENTION_MODE=persistent
# Fractional values are allowed: 0.25 = 15 minutes, handy for testing retention.
# BOT_RETENTION_HOURS=24
# CRON expression used here, use https://crontab.guru/ for examples
# BOT_REAP_INTERVAL=0 * * * *
# 50 MB is the standard Bot API ceiling; raise to ~2GB with a local Bot API server.
# Files above this are delivered as a signed URL instead of an upload.
BOT_TELEGRAM_MAX_UPLOAD=50000000
BOT_MAX_PENDING_PER_CHAT=5
# Warn in chat when a queued item's size estimate exceeds this (100 MB).
BOT_LARGE_FILE_WARN=104857600
#GLUETUN CONF
#PROVIDER
#SERVICE_PROVIDER_VPN=protonvpn
#FREE=on
HTTP_PROXY=on
HTTP_PROXY_LISTENING_ADDRESS=:3128
HTTP_PROXY_USER=proton
# The password is NOT here. It lives in secrets/http_proxy_password.txt, which
# is gitignored, and docker-compose.yml hands it to gluetun as
# HTTPPROXY_PASSWORD_SECRETFILE. Create that file before `docker compose up` —
# a secret whose `file:` does not exist fails the whole stack.
#
#   printf %s 'your-password' > secrets/http_proxy_password.txt
#
# The same password appears inside secrets/proxy_string.txt, which is what
# yt-diff itself reads (PROXY_STRING_FILE); the two have to agree.
HTTP_PROXY_STEALTH=on
#PROXY_STRING=http://proton:<password>@gluetun:3128/
# OPENVPN
#JAPAN
#SERVER_COUNTRIES_PREFERRED=Japan
# Deployment-specific values belong in local.env, pi5.env, or pi4.env
# DB_LOCATION=/home/sagnik/Documents/yt-db-data/
# HOSTNAME=ideapad.tail9ece4.ts.net
# LOG_LEVELS=trace
# HOST_SAVE_PATH=/home/sagnik/Documents/syncthing/pi5/yt-diff-data/
# DB_BACKUP_LOCATION=/home/sagnik/Documents/yt-db-backups/
# HOST_COOKIES_FILE=/home/sagnik/Projects/docker-composes/yt-diff/secrets/cookie_secret.txt
